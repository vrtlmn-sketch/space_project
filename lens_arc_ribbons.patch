+// ONE owner of every cloud-particle draw.
+//
+// Issues the ordinary point-sprite pass and, where the forward lens stretches a
+// source into a genuine arc, a second pass of ARC RIBBONS that draws the
+// annular sector itself instead of a square bounding it. The two passes
+// PARTITION the particles — the point pass holds an arc back, the ribbon pass
+// skips everything that is not one — from the same muT/muR test, so nothing is
+// drawn twice (multiplicative dust would darken those pixels twice) and nothing
+// is dropped.
+//
+// Every site that used to call glDrawArraysInstanced(GL_POINTS, ...) goes
+// through here. A site that forgot the ribbon pass would silently lose every
+// lensed particle, which is exactly the failure the two-phase dust split
+// already produced once.
+void RenderedObject::drawCloudParticles(unsigned program, int first, int count)
+{
+  if (count <= 0) return;
+  const GLint locRib = glGetUniformLocation((GLuint)program, "uLfRibbon");
+  const bool  ribbons = gLfRibbons && gLfCount > 0 && locRib >= 0;
+  if (!ribbons) {
+    if (locRib >= 0) glUniform1i(locRib, 0);
+    glDrawArraysInstanced(GL_POINTS, first, count, gLfImages);
+    return;
+  }
+
+  // The record buffer is indexed by absolute particle index, so it is sized to
+  // the whole cloud even when a chunk of it is being drawn.
+  // One record per (particle, IMAGE): the point pass runs once per image and
+  // each pass places a different arc for the same particle.
+  const int kLfMaxImages = 1 + 4;               // direct + one secondary per hole
+  const int need = first + count;
+  if (ribbonRecCap < need) {
+    if (!ribbonRecSsbo) { GLuint b = 0; glGenBuffers(1, &b); ribbonRecSsbo = b; }
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, (GLuint)ribbonRecSsbo);
+    glBufferData(GL_SHADER_STORAGE_BUFFER,
+                 (GLsizeiptr)need * kLfMaxImages * 7 * 4 * sizeof(float),
+                 nullptr, GL_DYNAMIC_COPY);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
+    ribbonRecCap = need;
+  }
+  glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 10, (GLuint)ribbonRecSsbo);
+  GLint l0;
+
+  if ((l0 = glGetUniformLocation((GLuint)program, "uLfImages")) >= 0) glUniform1i(l0, kLfMaxImages);
+  // BOTH directions need a barrier, and forgetting the first one is a race that
+  // looks like nothing: every cloud pass (haze, gas, cores, dust) reuses these
+  // records, so this pass's point draw OVERWRITES what the previous pass's
+  // ribbon draw may still be reading. Write-after-read is not ordered for us.
+  // The symptom was a 38x72 patch on the photon ring that changed between two
+  // otherwise byte-identical runs — small enough to read as noise, and the one
+  // thing this harness is supposed to guarantee is that reruns are identical.
+  glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT);
+  glUniform1i(locRib, 1);                       // points, arcs held back
+  glDrawArraysInstanced(GL_POINTS, first, count, gLfImages);
+  // ...and read-after-write, for the draw below.
+  glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT);
+
+  glUniform1i(locRib, 2);                       // the arcs
+  GLint l;
+  if ((l = glGetUniformLocation((GLuint)program, "uLfRibSegs"))  >= 0) glUniform1i(l, gLfRibSegs);
+  if ((l = glGetUniformLocation((GLuint)program, "uLfRibFirst")) >= 0) glUniform1i(l, first);
+  if ((l = glGetUniformLocation((GLuint)program, "uLfImages"))   >= 0) glUniform1i(l, kLfMaxImages);
+  const GLint locImg = glGetUniformLocation((GLuint)program, "uLfImage");
+  // The particle becomes the INSTANCE and gl_VertexID a corner of the strip, so
+  // the per-particle attributes have to advance once per instance instead of
+  // once per vertex. Restored below: the VAO is shared with every other pass.
+  glVertexAttribDivisor(0, 1);
+  glVertexAttribDivisor(2, 1);
+  glVertexAttribDivisor(3, 1);
+  const GLboolean hadCull = glIsEnabled(GL_CULL_FACE);
+  if (hadCull) glDisable(GL_CULL_FACE);         // a ribbon's winding flips around the hole
+  const GLsizei verts = (GLsizei)(2 * (gLfRibSegs + 1));
+  // One draw per image rather than folding the image into gl_InstanceID: with a
+  // divisor the instance index IS the attribute index, so it cannot also carry
+  // a second field.
+  for (int img = 0; img < gLfImages; ++img) {
+    if (locImg >= 0) glUniform1i(locImg, img);
+    glDrawArraysInstancedBaseInstance(GL_TRIANGLE_STRIP, 0, verts, count, (GLuint)first);
+  }
+  if (hadCull) glEnable(GL_CULL_FACE);
+  glVertexAttribDivisor(0, 0);
+  glVertexAttribDivisor(2, 0);
+  glVertexAttribDivisor(3, 0);
+  glUniform1i(locRib, 0);
+}
