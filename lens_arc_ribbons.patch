+// Live cost readout for the lens work. Sampled here because BeginFrame is the
+// one point every frame passes through, live and headless alike, so the live
+// panel and the --compare harness report the same number.
+void Renderer::SampleLensPerf() {
+  gLfFragCount = lensFragOn ? 1 : 0;
+  if (!lensPerfOn && !lensFragOn) { lensPerfPrev = 0.0; lensPerfHist.clear(); lensFragHist.clear(); return; }
+  auto median = [](std::vector<double> v) {
+    if (v.empty()) return 0.0;
+    std::nth_element(v.begin(), v.begin() + v.size() / 2, v.end());
+    return v[v.size() / 2];
+  };
+  if (lensPerfOn) {
+    // A fence, not a wall-clock delta. Without it the reading is whatever the
+    // driver has queued, which on this pipeline swung 45-112 ms for the SAME
+    // scene and is what made the old slope method unusable.
+    glFinish();
+    const double now = glfwGetTime();
+    if (lensPerfPrev > 0.0) {
+      lensPerfHist.push_back((now - lensPerfPrev) * 1000.0);
+      if (lensPerfHist.size() > 60) lensPerfHist.erase(lensPerfHist.begin());
+      lensPerfMs = (float)median(lensPerfHist);
+    }
+    lensPerfPrev = glfwGetTime();
+  }
+  if (lensFragOn && gLfFragCountSsbo) {
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, (GLuint)gLfFragCountSsbo);
+    if (GLuint* m = (GLuint*)glMapBuffer(GL_SHADER_STORAGE_BUFFER, GL_READ_ONLY)) {
+      lensFragHist.push_back((double)*m);
+      if (lensFragHist.size() > 60) lensFragHist.erase(lensFragHist.begin());
+      lensPerfFrag = median(lensFragHist);
+      glUnmapBuffer(GL_SHADER_STORAGE_BUFFER);
+    }
+    const GLuint zero = 0;
+    glBufferSubData(GL_SHADER_STORAGE_BUFFER, 0, sizeof(GLuint), &zero);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
+  } else if (lensFragOn) {
+    GLuint b = 0; glGenBuffers(1, &b);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, b);
+    const GLuint zero = 0;
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(GLuint), &zero, GL_DYNAMIC_READ);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
+    gLfFragCountSsbo = b;
+  }
+}
